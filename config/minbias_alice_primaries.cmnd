! minbias_alice_primaries.cmnd
! Same as minbias.cmnd, but with the ALICE definition of primary particles.
! Used only for the comparison with ALICE data, not for the histograms required by the task.

! Settings used in the main program
Main:numberOfEvents = 100000

! Settings related to the incoming beams
Beams:idA = 2212
Beams:idB = 2212
Beams:eCM = 13600

! Settings related to the process selection
SoftQCD:inelastic = on

! Settings related to the model parameters
! Monash 2013 tune: the Pythia default, set explicitly to document the model behind the results
Tune:pp = 14

! Settings related to particle decays
! Only particles with c*tau0 < 10 mm are decayed, as in the ALICE definition of primary particles.
ParticleDecays:limitTau0 = on
ParticleDecays:tau0Max = 10

! Settings related to the random number generator
Random:setSeed = on
Random:seed = 12345
